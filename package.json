{
	"name": "majsoul",
	"productName": "majsoul",
	"main": "main.js",
	"version": "1.0.0",
	"scripts": {
		"start": "NODE_ENV=development electron .",
		"build": "npm run build:all",
		"build:appimage": "NODE_ENV=production electron-builder --linux AppImage",
		"build:tar": "NODE_ENV=production electron-builder --linux tar.gz",
		"build:all": "sh build.sh appimage && sh build.sh tar",
		"clean": "rm -rf release/ dist/",
		"clean:full": "rm -rf release/ dist/ build_resources/"
	},
	"devDependencies": {
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3"
	},
	"build": {
		"appId": "com.majsoul.desktop",
		"productName": "Mahjong Soul",
		"asarUnpack": [
			"**/*.py",
			"**/requirements.txt"
		],
		"directories": {
			"output": "release",
			"buildResources": "build_resources"
		},
		"files": [
			"main.js",
			"MajsoulMax/**/*"
		],
		"extraResources": [
			{
				"from": "build_resources/python",
				"to": "python",
				"filter": ["**"]
			},
			{
				"from": "build_resources/pip",
				"to": "pip",
				"filter": ["**"]
			},
			{
				"from": "MajsoulMax",
				"to": "MajsoulMax",
				"filter": ["**"]
			}
		],
		"linux": {
			"target": [
				{ "target": "AppImage" },
				{ "target": "tar.gz" }
			],
			"category": "Game",
			"synopsis": "Mahjong Soul desktop client with MajsoulMax mod support"
		}
	}
}
